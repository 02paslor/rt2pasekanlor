    <script>
        // ==========================================
        // KETERANGAN: KONFIGURASI URL GOOGLE APPS SCRIPT
        // MASUKKAN URL WEB APP ANDA DI SINI SETELAH DEPLOY SCRIPT .gs
        // ==========================================
        const GAS_URL = 'https://script.google.com/macros/s/AKfycbz_XXXXXXXXXX_CONTOH_SAJA/exec'; 
        
        // --- LOGIKA LOGIN (Sesuai Permintaan: 0203 / 0203) ---
        function prosesLogin() {
            const user = document.getElementById('username').value;
            const pass = document.getElementById('password').value;
            const errorMsg = document.getElementById('loginError');

            if (user === '0203' && pass === '0203') {
                document.getElementById('loginSection').classList.add('hide');
                document.getElementById('mainApp').classList.remove('hide');
            } else {
                errorMsg.classList.remove('hidden');
                setTimeout(() => errorMsg.classList.add('hidden'), 3000);
            }
        }

        function logout() {
            document.getElementById('username').value = '';
            document.getElementById('password').value = '';
            document.getElementById('mainApp').classList.add('hide');
            document.getElementById('loginSection').classList.remove('hide');
            bukaHalaman('home'); // Reset ke home saat logout
        }

        // --- LOGIKA NAVIGASI 12 HALAMAN ---
        function bukaHalaman(pageId) {
            // Sembunyikan semua section
            const sections = document.querySelectorAll('.page-section');
            sections.forEach(sec => sec.classList.add('hide'));
            
            // Tampilkan section yang dituju
            const target = document.getElementById('page-' + pageId);
            if (target) {
                target.classList.remove('hide');
            }

            // Ubah state aktif di tombol sidebar
            const btns = document.querySelectorAll('.nav-btn');
            btns.forEach(btn => btn.classList.remove('active', 'border-l-4', 'border-brand-tosca', 'bg-white/10'));
            
            // Cari tombol yang diklik berdasarkan atribut onclick (Simpel matching)
            const activeBtn = Array.from(btns).find(b => b.getAttribute('onclick').includes(pageId));
            if(activeBtn) {
                activeBtn.classList.add('active', 'border-l-4', 'border-brand-tosca', 'bg-white/10');
            }

            // Tutup menu mobile jika sedang terbuka
            const navMenu = document.getElementById('navMenu');
            if (window.innerWidth < 768 && !navMenu.classList.contains('hidden')) {
                navMenu.classList.add('hidden');
            }

            // Jika membuka Keuangan, otomatis ambil data
            if (pageId === 'keuangan') {
                bacaDataKeuangan();
            }
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('navMenu');
            menu.classList.toggle('hidden');
        }

        // --- LOGIKA MODAL ---
        function bukaModal(id) {
            document.getElementById(id).classList.remove('hide');
        }
        function tutupModal(id) {
            document.getElementById(id).classList.add('hide');
        }

        // ==========================================
        // FUNGSI 2 ARAH (BACA & TULIS KE GOOGLE SHEETS)
        // ==========================================

        // Fungsi Generik untuk mengirim POST request ke GS
        async function fetchGoogleSheets(payload) {
            if (GAS_URL.includes('CONTOH_SAJA')) {
                alert("PERHATIAN: URL Google Apps Script belum diisi. Anda harus mendeploy backend.gs terlebih dahulu dan memasukkan URL-nya ke baris const GAS_URL.");
                return null;
            }
            try {
                const response = await fetch(GAS_URL, {
                    method: 'POST',
                    headers: {
                        // Header text/plain SANGAT PENTING untuk mencegah error blokir CORS dari browser
                        'Content-Type': 'text/plain;charset=utf-8', 
                    },
                    body: JSON.stringify(payload),
                    // Google Apps Script selalu melakukan redirect internal, ini wajib diaktifkan
                    redirect: 'follow' 
                });
                return await response.json();
            } catch (error) {
                console.error("Error GS:", error);
                alert("Terjadi kesalahan koneksi ke Spreadsheet.");
                return null;
            }
        }

        // CONTOH BACA DATA (Halaman Keuangan)
        async function bacaDataKeuangan() {
            const tbody = document.getElementById('tabel-keuangan');
            tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-white/60"><i class="fas fa-spinner fa-spin mr-2"></i> Sinkronisasi Data...</td></tr>`;
            
            // Nama sheet harus sama persis dengan yang ada di Spreadsheet Anda (Contoh: "Keuangan")
            const payload = { action: "read", sheetName: "Keuangan" }; 
            
            const res = await fetchGoogleSheets(payload);
            
            if (res && res.status === 'success') {
                if (res.data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center">Belum ada data keuangan.</td></tr>`;
                    return;
                }
                
                tbody.innerHTML = '';
                res.data.forEach(row => {
                    // Asumsi kolom Spreadsheet: Tanggal | Keterangan | Pemasukan | Pengeluaran
                    // Pastikan Header baris ke-1 di Spreadsheet sama persis namanya.
                    let html = `
                        <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
                            <td class="p-4">${row.Tanggal || '-'}</td>
                            <td class="p-4">${row.Keterangan || '-'}</td>
                            <td class="p-4 text-green-300">Rp ${row.Pemasukan ? Number(row.Pemasukan).toLocaleString('id-ID') : '0'}</td>
                            <td class="p-4 text-red-300">Rp ${row.Pengeluaran ? Number(row.Pengeluaran).toLocaleString('id-ID') : '0'}</td>
                        </tr>
                    `;
                    tbody.insertAdjacentHTML('beforeend', html);
                });
            }
        }

        // CONTOH TULIS DATA (Modal Keuangan)
        async function simpanKas(event) {
            event.preventDefault();
            const btn = document.getElementById('btnSimpanKas');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';
            btn.disabled = true;

            const tgl = document.getElementById('kas_tgl').value;
            const ket = document.getElementById('kas_ket').value;
            const ins = document.getElementById('kas_in').value;
            const outs = document.getElementById('kas_out').value;

            // Pastikan urutan array data sama dengan urutan kolom di Sheet "Keuangan"
            const payload = {
                action: "insert",
                sheetName: "Keuangan",
                data: [tgl, ket, ins, outs]
            };

            const res = await fetchGoogleSheets(payload);
            
            if (res && res.status === 'success') {
                alert("Data berhasil disimpan ke Spreadsheet!");
                tutupModal('modalTambahKeuangan');
                document.getElementById('kas_ket').value = ''; // Reset
                bacaDataKeuangan(); // Refresh tabel
            }
            
            btn.innerHTML = 'Simpan Kas';
            btn.disabled = false;
        }

        // CONTOH TULIS DATA (Form Warga)
        async function simpanDataWarga(event) {
            event.preventDefault();
            const btn = document.getElementById('btnSubmitWarga');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Mengirim Data...';
            btn.disabled = true;

            const nama = document.getElementById('warga_nama').value;
            const nik = document.getElementById('warga_nik').value;
            const blok = document.getElementById('warga_blok').value;
            const status = document.getElementById('warga_status').value;

            // Sheet "DataWarga" harus dibuat di Spreadsheet
            const payload = {
                action: "insert",
                sheetName: "DataWarga", 
                data: [nama, nik, blok, status]
            };

            const res = await fetchGoogleSheets(payload);
            
            if (res && res.status === 'success') {
                alert("Data Warga berhasil masuk ke Spreadsheet!");
                document.getElementById('formWarga').reset();
            }
            
            btn.innerHTML = 'Simpan Data ke Spreadsheet';
            btn.disabled = false;
        }
    </script>
